library ieee;
use ieee.std_logic_1164.all;
use ieee.std_logic_unsigned.all;

entity busmux is
	port(
		a: in std_logic_vector ( 1 downto 0 );
		sal: out std_logic_vector ( 6 downto 0 )
	);
end busmux;

architecture behavioral of busmux is
begin
	process (a)
	begin 
		case a is
			when "00" => sal <= "0001001";
			when "01" => sal <= "1000000";
			when "10" => sal <= "1000111";
			when "11" => sal <= "0001000";
			when others => sal <= "0000000";
		end case;
	end process;
